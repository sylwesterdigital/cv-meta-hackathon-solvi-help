[Unit]
Description=SOLVI.help API / SQLite / WebSocket backend
After=network.target
[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/solvi-help
Environment=SOLVI_ALLOWED_ORIGINS=https://solvi.help
Environment=SOLVI_STATIC_ROOT=/var/www/solvi.help
Environment=SOLVI_DATA_DIR=/var/lib/solvi-help
EnvironmentFile=-/etc/solvi-help.env
ExecStart=/opt/solvi-help/.venv/bin/gunicorn --workers 1 --threads 12 --timeout 90 --bind 127.0.0.1:18765 server:app
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/var/www/solvi.help
ReadWritePaths=/var/lib/solvi-help
[Install]
WantedBy=multi-user.target
