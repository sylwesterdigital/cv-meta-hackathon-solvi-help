[Unit]
Description=SOLVI.help prototype WebSocket backend
After=network.target
[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/solvi-help
Environment=SOLVI_ALLOWED_ORIGINS=https://solvi.help
Environment=SOLVI_STATIC_ROOT=/var/www/solvi.help
ExecStart=/opt/solvi-help/.venv/bin/gunicorn --workers 1 --threads 12 --bind 127.0.0.1:8765 server:app
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/var/www/solvi.help
[Install]
WantedBy=multi-user.target
